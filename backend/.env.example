# Supabase Postgres connection string (IPv4 connection pooler URI)
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Embedding Model Provider (local sentence-transformers or openai)
LLM_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional Mailto for OpenAlex polite pool
OPENALEX_MAILTO=your-email@example.com

# Downloads Directory override (defaults to OS user Downloads directory)
DOWNLOADS_DIR=
